# .env.example → .env olarak kopyala. .env ASLA repoya girmez (.gitignore).

# Hedef repoyu yazmak (özel fork için):
# LAWS_REPO=gmalias/souverain-laws

# GitHub PAT (souverain-laws repoya read+write; scope: repo)
# Oluştur: https://github.com/settings/tokens — "Fine-grained PAT" önerilir
GITHUB_TOKEN=ghp_XXXXX
